#include <dt-bindings/zmk/mouse.h>

// #include <behaviors/rgbled_widget.dtsi>

#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

// Leyer

#define ARROW 1
#define NUM 2
#define AHK 3
#define FUNCTION 4

// Japanese

#define JP_MINUS MINUS        // -
#define JP_CARET EQUAL        // ^
#define JP_YEN   INT3         // ¥
#define JP_AT    LBKT         // @
#define JP_LBKT  RBKT         // [
#define JP_EISU  CAPS         // Eisu (英数)
#define JP_SEMI  SEMI         // ;
#define JP_COLON SQT          // :
#define JP_RBKT  NUHS         // ]
#define JP_COMMA COMMA        // ,
#define JP_DOT   DOT          // .
#define JP_SLASH SLASH        // /
#define JP_BSLH  INT1         // (backslash)
#define JP_MHEN  INT5         // Muhenkan (無変換)
#define JP_HENK  INT4         // Henkan (変換)
#define JP_EXCL  LS(N1)       // !
#define JP_DQT   LS(N2)       // "
#define JP_HASH  LS(N3)       // #
#define JP_DLLR  LS(N4)       // $
#define JP_PRCNT LS(N5)       // %
#define JP_AMPS  LS(N6)       // &
#define JP_SQT   LS(N7)       // '
#define JP_LPAR  LS(N8)       // (
#define JP_RPAR  LS(N9)       // )
#define JP_EQUAL LS(JP_MINUS) // =
#define JP_TILDE LS(JP_CARET) // ~
#define JP_PIPE  LS(JP_YEN)   // |
#define JP_GRAVE LS(JP_AT)    // `
#define JP_LBRC  LS(JP_LBKT)  // {
#define JP_CAPS  LS(JP_EISU)  // Caps Lock
#define JP_PLUS  LS(JP_SEMI)  // +
#define JP_ASTRK LS(JP_COLON) // *
#define JP_RBRC  LS(JP_RBKT)  // }
#define JP_LT    LS(JP_COMMA) // <
#define JP_RT    LS(JP_DOT)   // >
#define JP_QMARK LS(JP_SLASH) // ?
#define JP_UNDER LS(JP_BSLH)  // _

/ {
    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        my_sp: my_sp {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp JP_MHEN>, <&macro_tap>, <&kp LS(N3)>;
        };

        my_dq: my_dq {
            #binding-cells = <0>;
            compatible = "zmk,behavior-macro";
            bindings =
                <&macro_tap>,
                <&kp JP_MHEN>,
                <&macro_tap>,
                <&kp LS(N2)>,
                <&macro_tap>,
                <&kp LS(N2)>;
        };

        my_sq: my_sq {
            #binding-cells = <0>;
            compatible = "zmk,behavior-macro";
            bindings =
                <&macro_tap>,
                <&kp JP_MHEN>,
                <&macro_tap>,
                <&kp LS(N7)>,
                <&macro_tap>,
                <&kp LS(N7)>;
        };

        my_kakko: my_kakko {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp JP_MHEN>,
                <&macro_tap>,
                <&kp LS(N8)>,
                <&macro_tap>,
                <&kp LS(N9)>;
        };

        my_br: my_br {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp JP_MHEN>,
                <&macro_tap>,
                <&kp JP_LT>,
                <&macro_tap>,
                <&kp B>,
                <&macro_tap>,
                <&kp R>,
                <&macro_tap>,
                <&kp JP_RT>;
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        lt_mkp: lt_mkp {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_MKP";
            bindings = <&mo>, <&mkp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        rot_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            tap-ms = <20>;
        };

        rot_mkp: sensor_rotate_mkp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&mkp>, <&mkp>;

            tap-ms = <20>;
        };

        mouse_scroll: mouse_wheel_scrl {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };

        mouse_scroll2: mouse_wheel_scrl2 {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <16>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&none           &kp Q                    &kp W              &kp E                 &kp R             &kp T         &kp K_PASTE
&none           &kp A                    &kp S              &kp D                 &kp F             &kp G         &kp K_CUT
&none           &kp Z                    &kp X              &kp C                 &kp V             &kp B         &none        &kp K_REDO
&none           &none                    &none              &none                 &kp LEFT_CONTROL  &kp LEFT_ALT  &kp K_UNDO
&kp LSHIFT      &lt_to_layer_0 3 LANG2   &kp SPACE          &lt_to_layer_0 4 TAB  &kp K_COPY
&bootloader     &none                    &none              &none                 &none             &none         &none        &bt BT_CLR
&kp UP          &kp Y                    &kp U              &kp I                 &kp O             &kp P         &none
&kp DOWN        &kp H                    &kp J              &kp K                 &kp L             &kp COLON     &none
&kp RIGHT       &mkp RCLK                &kp N              &kp M                 &kp COMMA         &kp PERIOD    &kp MINUS    &none
&kp LEFT        &mkp LCLK                &kp RIGHT_GUI      &none                 &none             &none         &none
&kp ENTER       &lt_to_layer_0 2 ESCAPE  &kp ENTER          &lt 1 LANG1           &kp RIGHT_SHIFT
&bt BT_CLR_ALL  &kp K_MUTE               &kp C_VOLUME_DOWN  &kp C_VOLUME_UP       &kp PRINTSCREEN   &kp RG(L)     &none        &none
            >;

            sensor-bindings =
                <&mouse_scroll2 SCRL_UP SCRL_DOWN>,
                <&mouse_scroll SCRL_LEFT SCRL_RIGHT>;
        };

        ARROW {
            bindings = <
&none           &kp EXCL                &kp AT                   &kp HASH         &kp DLLR          &kp PRCNT     &kp K_PASTE
&none           &kp QMARK               &kp LBKT                 &kp RBKT         &kp LPAR          &kp RPAR      &kp K_CUT
&none           &kp SEMICOLON           &kp LBRC                 &kp RBRC         &kp LT            &kp GT        &none        &kp K_REDO
&none           &none                   &none                    &none            &kp LEFT_CONTROL  &kp LEFT_ALT  &kp K_UNDO
&kp LSHIFT      &lt_to_layer_0 3 LANG2  &kp SPACE                &lt_to_layer_0 4 TAB  &kp K_COPY
&bootloader     &none                   &none                    &none            &none             &none         &none        &bt BT_CLR
&kp UP          &kp AMPS                &kp PIPE                 &kp CARET        &kp UNDER         &kp TILDE     &none
&kp DOWN        &kp LEFT                &kp DOWN                 &kp UP           &kp RIGHT         &kp EQUAL     &none
&kp RIGHT       &mkp RCLK               &kp GRAVE                &kp BSLH         &kp SQT           &kp DQT       &kp MINUS    &none
&kp LEFT        &mkp LCLK               &kp RIGHT_GUI            &none            &none             &none         &none
&kp ENTER       &lt_to_layer_0 2 ESCAPE &kp ENTER                &lt 1 LANG1      &kp RIGHT_SHIFT
&bt BT_CLR_ALL  &kp K_MUTE              &kp C_VOLUME_DOWN        &kp C_VOLUME_UP  &kp PRINTSCREEN   &kp RG(L)     &none        &none
            >;

            sensor-bindings =
                <&mouse_scroll2 SCRL_UP SCRL_DOWN>,
                <&mouse_scroll SCRL_LEFT SCRL_RIGHT>;
        };

        other2 {
            bindings = <
&none           &none                   &none                    &none            &none             &none         &kp K_PASTE
&none           &none                   &none                    &none            &none             &none         &kp K_CUT
&none           &none                   &none                    &none            &none             &none         &none          &kp K_REDO
&none           &none                   &none                    &none            &kp LEFT_CONTROL  &kp LEFT_ALT  &kp K_UNDO
&kp LSHIFT      &lt_to_layer_0 3 LANG2  &kp SPACE                &lt_to_layer_0 4 TAB  &kp K_COPY
&bootloader     &none                   &none                    &none            &none             &none         &none          &bt BT_CLR
&kp UP          &none                   &none                    &none            &none             &none         &none
&kp DOWN        &mkp MCLK               &none                    &none            &none             &kp DELETE    &none
&kp RIGHT       &mkp RCLK               &none                    &none            &none             &none         &kp BACKSPACE  &none
&kp LEFT        &mkp LCLK               &kp RIGHT_GUI            &none            &none             &none         &none
&kp ENTER       &lt_to_layer_0 2 ESCAPE &kp ENTER                &lt 1 LANG1      &kp RIGHT_SHIFT
&bt BT_CLR_ALL  &kp K_MUTE              &kp C_VOLUME_DOWN        &kp C_VOLUME_UP  &kp PRINTSCREEN   &kp RG(L)     &none          &none
            >;

            sensor-bindings =
                <&mouse_scroll2 SCRL_UP SCRL_DOWN>,
                <&mouse_scroll SCRL_LEFT SCRL_RIGHT>;
        };

        number {
            bindings = <
&none           &kp COLON               &kp N1                   &kp N2           &kp N3            &kp COMMA     &kp K_PASTE
&none           &kp SEMI                &kp N4                   &kp N5           &kp N6            &kp DOT       &kp K_CUT
&none           &kp PRCNT               &kp N7                   &kp N8           &kp N9            &kp N0        &none        &kp K_REDO
&none           &none                   &none                    &none            &kp LEFT_CONTROL  &kp LEFT_ALT  &kp K_UNDO
&kp LSHIFT      &lt_to_layer_0 3 LANG2  &kp SPACE                &lt_to_layer_0 4 TAB  &kp K_COPY
&bootloader     &none                   &none                    &none            &none             &none         &none        &bt BT_CLR
&kp UP          &kp AMPS                &kp PIPE                 &kp CARET        &kp UNDER         &kp TILDE     &none
&kp DOWN        &kp PLUS                &kp MINUS                &kp ASTRK        &kp FSLH          &kp EQUAL     &none
&kp RIGHT       &mkp RCLK               &kp GRAVE                &kp BSLH         &kp SQT           &kp DQT       &kp MINUS    &none
&kp LEFT        &mkp LCLK               &kp RIGHT_GUI            &none            &none             &none         &none
&kp ENTER       &lt_to_layer_0 2 ESCAPE &kp ENTER                &lt 1 LANG1      &kp RIGHT_SHIFT
&bt BT_CLR_ALL  &kp K_MUTE              &kp C_VOLUME_DOWN        &kp C_VOLUME_UP  &kp PRINTSCREEN   &kp RG(L)     &none        &none
            >;

            sensor-bindings =
                <&mouse_scroll2 SCRL_UP SCRL_DOWN>,
                <&mouse_scroll SCRL_LEFT SCRL_RIGHT>;
        };

        FUNCTION {
            bindings = <
&none           &none                   &kp F1                   &kp F2            &kp F3           &kp F4        &kp K_PASTE
&none           &none                   &kp F5                   &kp F6            &kp F7           &kp F8        &kp K_CUT
&none           &none                   &kp F9                   &kp F10           &kp F11          &kp F12       &none        &kp K_REDO
&none           &none                   &none                    &none             &kp LEFT_CONTROL &kp LEFT_ALT  &kp K_UNDO
&kp LSHIFT      &lt_to_layer_0 3 LANG2  &kp SPACE                &lt_to_layer_0 4 TAB  &kp K_COPY
&bootloader     &none                   &none                    &none             &none            &none         &none        &bt BT_CLR
&kp UP          &kp COLON               &kp N1                   &kp N2            &kp N3           &kp COMMA     &none
&kp DOWN        &kp SEMI                &kp N4                   &kp N5            &kp N6           &kp DOT       &none
&kp RIGHT       &mkp RCLK               &kp PRCNT                &kp N7            &kp N8           &kp N9        &kp N0       &none
&kp LEFT        &mkp LCLK               &kp RIGHT_GUI            &none             &none            &none         &none
&kp ENTER       &lt_to_layer_0 2 ESCAPE &kp ENTER                &lt 1 LANG1       &kp RIGHT_SHIFT
&bt BT_CLR_ALL  &kp K_MUTE              &kp C_VOLUME_DOWN        &kp C_VOLUME_UP   &kp PRINTSCREEN  &kp RG(L)     &none        &none
            >;

            sensor-bindings =
                <&mouse_scroll2 SCRL_UP SCRL_DOWN>,
                <&mouse_scroll SCRL_LEFT SCRL_RIGHT>;
        };
    };
};
